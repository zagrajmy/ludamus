ALLOWED_HOSTS=".localhost"
AUTH0_CLIENT_ID="test-auth0-client-id"
AUTH0_CLIENT_SECRET="test-auth0-client-secret"
AUTH0_DOMAIN="auth0.example.com"
DB_NAME="dev.e2e.sqlite3"
DJANGO_SETTINGS_MODULE="ludamus.edges.settings"
EMAIL_URL="filemail:///tests/e2e/.e2e-mail"
ENV="test"
PYTHONPATH="src"
ROOT_DOMAIN="localhost:8000"
SECRET_KEY="e2e-secret-key"
SESSION_COOKIE_DOMAIN=".localhost"
CREDENTIALS_ENCRYPTION_KEY="gWc408f8j3ZQUm5Ly4EXQC2EwFRf50AhePkmZKL5N9E="
IN_TESTS='True'
# Serve the enforcing CSP header (nonces, no unsafe-inline/eval in
# script-src) so the e2e suite can prove the real production policy
# doesn't break any page — see plan 019 and csp-violations.spec.ts.
ENABLE_CSP='True'

# Fake PostHog credentials so the consent banner and prologue.ts render in
# e2e. The host points back at the app server, not a real PostHog project:
# any event posthog-js emits after an "accept" lands on Django as a harmless
# 404 instead of leaving the machine, and connect-src gains nothing beyond
# 'self'. tests/conftest.py's POSTHOG_API_KEY guard only covers pytest
# (.env.test, pinned empty there); Playwright never loads pytest's conftest,
# so this file's own value is what actually governs the e2e runserver.
POSTHOG_API_KEY="phc_e2e_fake_key"
POSTHOG_HOST="http://localhost:8000"
