ALLOWED_HOSTS=".testserver"
AUTH0_CLIENT_ID="test-auth0-client-id"
AUTH0_CLIENT_SECRET="test-auth0-client-secret"
AUTH0_DOMAIN="auth0.example.com"
CREDENTIALS_ENCRYPTION_KEY="gWc408f8j3ZQUm5Ly4EXQC2EwFRf50AhePkmZKL5N9E="
DB_NAME=":memory:"
ENV="test"
IN_TESTS='True'
ZEAL_RAISE=True
MEMBERSHIP_API_BASE_URL="https://membership-test.example.com/api/v1/endpoint"
MEMBERSHIP_API_TOKEN="membership-test-token"
# Tests drive DBOS explicitly (test_dbos_scheduler.py); never launch implicitly.
SCHEDULER_MODE="cron"
ROOT_DOMAIN="testserver"
SECRET_KEY="dev-secret-key"
SESSION_COOKIE_DOMAIN=".testserver"

# Empty, not absent: without an entry here an exported POSTHOG_API_KEY
# (varlock loads .env.local in every environment, and POSTHOG_TODO.md tells
# you to put a real key there to see the consent banner) stays visible to
# the suite, and got_request_exception ships every deliberate test fault to
# the live project.
POSTHOG_API_KEY=""
