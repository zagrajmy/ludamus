+// Parks like io_wait_on, but the loop also wakes the activation once
+// until (an io_tick deadline) has passed, with late set, so more can
+// answer a timeout instead of retrying the fd.
+static Term io_wait_until(IoWork* w, int fd, short evts, IoPack more, u64 until) {
+  io_wait_on(w, fd, evts, more);
+  ((IoAct*)w)->until = until;
+  return IO_PARK;
+}
