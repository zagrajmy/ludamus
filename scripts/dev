#!/usr/bin/env bash

set -euo pipefail

port=""
sphere=""
use_portless="1"
use_lan="0"
do_trust="0"

if [ "${NO_COLOR:-}" != "" ]; then
  unset FORCE_COLOR
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -p|--port)
      shift
      port="${1:-}"
      if [ -z "$port" ]; then
        echo "missing port after -p/--port" >&2
        exit 2
      fi
      ;;
    --sphere)
      shift
      sphere="${1:-}"
      if [ -z "$sphere" ]; then
        echo "missing sphere after --sphere" >&2
        exit 2
      fi
      ;;
    --lan)
      use_lan="1"
      ;;
    --trust)
      do_trust="1"
      ;;
    --portless)
      use_portless="1"
      ;;
    --no-portless)
      use_portless="0"
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "unknown arg: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ -n "$port" ]; then
  export PORTLESS_APP_PORT="$port"
fi

if [ -n "$sphere" ]; then
  export DEV_SPHERE="$sphere"
fi

if [ "${PORT:-}" != "" ]; then
  export PORTLESS_APP_PORT="${PORT}"
fi

if [ "${VITE_PORT:-}" = "" ]; then
  export VITE_PORT="$(mise x -- python -c "import socket; s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()")"
fi

# Migrate only when the migration files changed (or the DB is missing) —
# a no-op migrate still boots Django (~1.6 s), too slow for every start.
migrate_if_needed() {
  local stamp=".local/dev-migrate.stamp"
  local db_file="${DB_NAME:-ludamus.sqlite3}"
  local current
  current="$(find src -path '*/migrations/*.py' -type f -print0 \
    | LC_ALL=C sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1)"
  if [ "${USE_POSTGRES:-}" != "true" ] && [ ! -f "$db_file" ]; then
    : # fresh DB — always migrate
  elif [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$current" ]; then
    if [ "${USE_POSTGRES:-}" != "true" ] || django-admin migrate --check >/dev/null 2>&1; then
      return 0
    fi
  fi
  django-admin migrate --noinput
  mkdir -p .local
  printf '%s' "$current" > "$stamp"
}
migrate_if_needed

if [ "$use_portless" = "1" ]; then
  PORTLESS=(aubr portless)

  printf '[dev] root=portless\n' >&2

  if [ "$use_lan" = "1" ]; then
    export PORTLESS_LAN=1
    if [ "$do_trust" = "1" ]; then
      sudo -E "${PORTLESS[@]}" trust
    fi
    PORTLESS=(sudo -E "${PORTLESS[@]}")
  else
    export PORTLESS_PORT=1355
    export PORTLESS_TLD=localhost
    export PORTLESS_LAN=0
    export PORTLESS_HTTPS=0
  fi

  exec "${PORTLESS[@]}" run --force -- ./scripts/dev-portless-child
fi

export PORT="${PORT:-8000}"
printf '[dev] root=%s\n' "${ROOT_DOMAIN:-?}" >&2
exec honcho start -e /dev/null -f Procfile.dev
