#!/usr/bin/env bash
# Inner half of `mise dev` once portless has wrapped the process.
# Reads PORTLESS_URL, normalizes ROOT_DOMAIN/ALLOWED_HOSTS, syncs Site(SITE_ID),
# and exec's honcho. Pulled out of scripts/dev so the LAN and non-LAN
# branches can share it without each carrying a 14-line `bash -lc` heredoc.

set -euo pipefail

if [ -z "${PORTLESS_URL:-}" ]; then
  echo "[dev] PORTLESS_URL missing" >&2
  exit 1
fi

root_domain="${PORTLESS_URL#http://}"
root_domain="${root_domain#https://}"
root_domain="${root_domain%/}"

export ROOT_DOMAIN="$root_domain"
export ALLOWED_HOSTS=".localhost,127.0.0.1,localhost,.local"

printf '[dev] auth0=%s root=%s app_port=%s\n' \
  "${AUTH0_DOMAIN:-?}" "$ROOT_DOMAIN" "${PORT:-?}" >&2

python - <<'PY'
import os
import sys

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "ludamus.edges.settings")
import django

django.setup()
from django.conf import settings
from django.contrib.sites.models import Site
from django.db import transaction

from ludamus.links.db.django.models import Sphere


def swap_domains(first: Site, second: Site) -> None:
    first_domain = first.domain
    second_domain = second.domain
    temporary_domain = f"sphere-swap-{first.pk}-{second.pk}.invalid"
    Site.objects.filter(pk=first.pk).update(domain=temporary_domain)
    Site.objects.filter(pk=second.pk).update(domain=first_domain)
    Site.objects.filter(pk=first.pk).update(domain=second_domain)


root_domain = os.environ["ROOT_DOMAIN"]
requested_sphere = os.environ.get("DEV_SPHERE", "").strip()

with transaction.atomic():
    canonical_site, _ = Site.objects.get_or_create(
        id=settings.SITE_ID, defaults={"domain": root_domain, "name": root_domain}
    )
    root_holder = Site.objects.filter(domain=root_domain).first()

    if root_holder is None:
        print(
            f"[dev] Site(id={canonical_site.pk}).domain: "
            f"{canonical_site.domain!r} -> {root_domain!r}",
            file=sys.stderr,
        )
        canonical_site.domain = root_domain
        canonical_site.name = root_domain
        canonical_site.save(update_fields=("domain", "name"))
    elif root_holder.pk != canonical_site.pk:
        swap_domains(root_holder, canonical_site)
        canonical_site.refresh_from_db()

    if requested_sphere:
        if requested_sphere.isdecimal():
            target_sphere = (
                Sphere.objects.select_related("site")
                .filter(pk=int(requested_sphere))
                .first()
            )
        else:
            name_matches = list(
                Sphere.objects.select_related("site").filter(
                    name__iexact=requested_sphere
                )[:2]
            )
            if len(name_matches) > 1:
                raise SystemExit(
                    f"Multiple spheres match {requested_sphere!r} by name; "
                    "pass the sphere id (DEV_SPHERE=<pk>) instead."
                )
            target_sphere = name_matches[0] if name_matches else None
        if target_sphere is None:
            raise SystemExit(f"No sphere matches {requested_sphere!r} by id or name.")
        if target_sphere.site_id != canonical_site.pk:
            swap_domains(canonical_site, target_sphere.site)
        current_sphere = target_sphere
    else:
        current_sphere = (
            Sphere.objects.select_related("site").filter(site=canonical_site).first()
        )

# A fresh database has no sphere on the canonical site yet, and the server
# still has to start so someone can create one.
sphere_name = current_sphere.name if current_sphere else "(none)"
print(f"[dev] sphere={sphere_name!r} root={root_domain}", file=sys.stderr)
PY

exec honcho start -e /dev/null -f Procfile.dev
