{
  "name": "@ludamus/parley-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- wrangler dev",
    "plan:prod": "PARLEY_ENV=production varlock run -- alchemy plan --stage prod",
    "deploy:prod": "PARLEY_ENV=production varlock run -- alchemy deploy --stage prod",
    "plan:staging": "PARLEY_ENV=production varlock run -- alchemy plan --stage staging",
    "deploy:staging": "PARLEY_ENV=production varlock run -- alchemy deploy --stage staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agents": "0.29.0",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@effect/platform-node": "4.1.2",
    "@types/node": "24.10.1",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "5.9.3",
    "varlock": "1.12.0",
    "vitest": "4.1.9",
    "wrangler": "4.145.0"
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true,
      "core-js-pure": false,
      "workerd": true
    }
  }
}
