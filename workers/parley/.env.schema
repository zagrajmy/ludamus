# Parley's inputs, validated by varlock. `aube run dev` and the deploy
# scripts load them; Parley reads no .dev.vars or plain .env.
# @currentEnv=$PARLEY_ENV @defaultSensitive=false @defaultRequired=true
# ---

# The deploy scripts set production.
# @type=enum(development, production)
PARLEY_ENV=development

# Comma-separated origins allowed to open Parley. Local dev takes
# ALLOWED_ORIGINS from wrangler.json instead.
# @required=forEnv(production)
PARLEY_ALLOWED_ORIGINS=

# Hostname the production Worker serves, on the app's own site (e.g.
# parley.<ROOT_DOMAIN>): its cookie is SameSite=Strict.
# @required=forEnv(production)
PARLEY_DOMAIN=

# Public half of the app's PARLEY_SIGNING_PRIVATE_KEY, in PEM form.
PARLEY_PUBLIC_KEY=

# Lets session rooms post activity to the sphere room. Deploys generate their
# own and keep it in Alchemy's state.
# @sensitive @required=forEnv(development)
PARLEY_INTERNAL_SECRET=
