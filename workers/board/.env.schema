# The board Worker's inputs, validated by varlock. `aube run dev:worker`,
# `aube run serve` and the deploy scripts load them; the Worker reads no
# .dev.vars or plain .env.
# @currentEnv=$BOARD_ENV @defaultSensitive=false @defaultRequired=true
# ---

# The deploy scripts set production.
# @type=enum(development, production)
BOARD_ENV=development

# The app's ROOT_DOMAIN. A deploy serves board.<ROOT_DOMAIN>, redirects
# vtt., tabletop. and tablica.<ROOT_DOMAIN> to it, and builds the client to
# ask https://<ROOT_DOMAIN> for passes. Development reads none: the Worker
# then takes wrangler.json's APP_ORIGIN and redirects nothing.
# @required=forEnv(production)
ROOT_DOMAIN=

# Public half of the key the app signs board passes with (the app's
# PARLEY_SIGNING_PRIVATE_KEY), in PEM form. .env.development holds the
# committed dev pair's; a deploy refuses it.
BOARD_PUBLIC_KEY=

# tldraw SDK licence key, built into the client. Public by design: tldraw
# ties it to the board's domain. Local runs work without one.
# @docs(url=https://tldraw.dev/community/license)
# @optional
TLDRAW_LICENSE_KEY=
