# The board Worker's inputs, validated by varlock. `aube run dev` loads
# them; the Worker reads no .dev.vars or plain .env.
# @currentEnv=$BOARD_ENV @defaultSensitive=false @defaultRequired=true
# ---

# @type=enum(development, production)
BOARD_ENV=development

# Public half of the key the app signs board passes with, in PEM form.
# .env.development holds the committed dev pair's.
BOARD_PUBLIC_KEY=
