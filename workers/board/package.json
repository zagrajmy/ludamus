{
  "name": "@ludamus/board-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:worker": "mkdir -p dist && varlock run -- wrangler dev --port 8789",
    "serve": "varlock run -- wrangler dev --port 8788",
    "serve:e2e": "varlock run -- wrangler dev --port 8790",
    "plan:prod": "BOARD_ENV=production varlock run -- alchemy plan --stage prod",
    "deploy:prod": "BOARD_ENV=production varlock run -- alchemy deploy --stage prod",
    "plan:staging": "BOARD_ENV=production varlock run -- alchemy plan --stage staging",
    "deploy:staging": "BOARD_ENV=production varlock run -- alchemy deploy --stage staging",
    "lint": "oxlint -c client/oxlint.config.ts --max-warnings 0 client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client"
  },
  "dependencies": {
    "@drdreo/dice-box-threejs": "1.1.0",
    "@tldraw/assets": "5.6.0",
    "@tldraw/sync": "5.6.0",
    "@tldraw/sync-core": "5.6.0",
    "@tldraw/tlschema": "5.6.0",
    "jose": "6.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "5.6.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@effect/platform-node": "4.1.2",
    "@hasparus/oxlint-config": "^0.3.0",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "oxlint": "1.70.0",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "varlock": "1.12.0",
    "vite": "8.1.6",
    "vitest": "4.1.9",
    "wrangler": "4.145.0"
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true,
      "workerd": true
    }
  }
}
