msgstr "Logo"

#: gates/web/django/forms.py
msgid ""
"Shown on the printable schedule. Max 8 MB. JPG, PNG, WebP, AVIF, or SVG."
msgstr ""
"Wyświetlone w harmonogramie do druku. Maks. 8 MB. JPG, PNG, WebP, AVIF lub "
"SVG."

#: gates/web/django/forms.py
msgid "Event slug is required."
msgstr "Slug wydarzenia jest wymagany."

#: gates/web/django/forms.py
msgid "Aim for about 230 characters."
msgstr "Celuj w około 230 znaków."

#: gates/web/django/forms.py
msgid "Address"
msgstr "Adres"

#: gates/web/django/forms.py
msgid "Venue address, two lines at most. Shown with a map link."
msgstr ""
"Adres miejsca wydarzenia, najwyżej dwie linie. Pokazywany z linkiem do mapy."

#: gates/web/django/forms.py
msgid "An address can have at most two lines."
msgstr "Adres może mieć najwyżej dwie linie."

#: gates/web/django/forms.py
msgid "Start time is required."
msgstr "Czas rozpoczęcia jest wymagany."

#: gates/web/django/forms.py
msgid "End time is required."
msgstr "Czas zakończenia jest wymagany."

#: gates/web/django/forms.py
msgid "Public: listed and announced to followers from its publication time"
msgstr ""
"Publiczne: od czasu publikacji widoczne na listach i ogłaszane obserwującym"

#: gates/web/django/forms.py
msgid ""
"Link only: anyone with the link can open it now; never listed or announced"
msgstr ""
"Tylko przez link: każdy z linkiem może je otworzyć już teraz; nie pojawia "
"się na listach ani w powiadomieniach"

#: gates/web/django/forms.py
msgid "Who can see the event"
msgstr "Kto widzi wydarzenie"

#: gates/web/django/forms.py
msgid "Publication time"
msgstr "Czas publikacji"

#: gates/web/django/forms.py
msgid ""
"For a public event: when it appears in event lists and followers are "
"notified. Leave empty to keep it hidden."
msgstr ""
"Dla wydarzenia publicznego: kiedy pojawi się na listach i obserwujący "
"dostaną powiadomienie. Zostaw puste, aby pozostało ukryte."

#: gates/web/django/forms.py
msgid "Use sphere default"
msgstr "Użyj domyślnego ustawienia sfery"

#: gates/web/django/forms.py
msgid "Facilitators editing their own sessions"
msgstr "Edycja własnych punktów programu przez twórców programu"

#: gates/web/django/forms.py
msgid "Automatically confirm program items once scheduled"
msgstr "Automatycznie potwierdzaj punkty programu po zaplanowaniu"

#: gates/web/django/forms.py
msgid ""
"When on, a program item is confirmed the moment it is placed on the "
"schedule. Turn off to confirm items manually."
msgstr ""
"Gdy włączone, punkt programu jest potwierdzany w chwili umieszczenia go w "
"harmonogramie. Wyłącz, aby potwierdzać punkty ręcznie."

#: gates/web/django/forms.py
msgid "Use placeholder images for sessions without a cover image"
msgstr "Używaj obrazów zastępczych dla punktów programu bez okładki"

#: gates/web/django/forms.py
msgid ""
"When off, sessions without uploaded images are shown as text-only cards."
msgstr ""
"Gdy wyłączone, punkty programu bez przesłanych obrazów są pokazywane jako "
"karty z samym tekstem."

#: gates/web/django/forms.py
msgid "Label the attendee count \"Participants\" instead of \"Players\""
msgstr "Oznacz licznik uczestników jako „Uczestnicy” zamiast „Gracze”"

#: gates/web/django/forms.py
msgid ""
"Turn on for non-gaming events so the public page counts participants rather "
"than players."
msgstr ""
"Włącz dla wydarzeń niegrowych, aby strona publiczna liczyła uczestników "
"zamiast graczy."

#: gates/web/django/forms.py
msgid "Allow facilitators to edit their own sessions"
msgstr "Pozwól twórcom programu edytować własne punkty programu"

#: gates/web/django/forms.py
msgid "Default for the whole sphere. Events can override this setting."
msgstr "Domyślne dla całej sfery. Wydarzenia mogą nadpisać to ustawienie."

#: gates/web/django/forms.py
msgid "Place event cover buttons at the bottom right"
msgstr "Umieść przyciski okładki wydarzenia na dole po prawej"

#: gates/web/django/forms.py
msgid ""
"Shows print and venue map buttons in a horizontal row at the bottom right of "
"event covers."
msgstr ""
"Wyświetla przyciski drukowania i map obiektu w poziomym rzędzie w prawym "
"dolnym rogu okładek wydarzeń."

#: gates/web/django/forms.py
msgid "Nobody (encounters are off here)"
msgstr "Nikt (spotkania są tu wyłączone)"

#: gates/web/django/forms.py
msgid "Sphere managers only"
msgstr "Tylko menedżerowie sfery"

#: gates/web/django/forms.py
msgid "Everyone"
msgstr "Wszyscy"

#: gates/web/django/forms.py
msgid "Who may organize encounters"
msgstr "Kto może organizować spotkania"

#: gates/web/django/forms.py
msgid ""
"Encounters are small meetups organized by hand. Public ones are listed for "
"everyone on the events page."
msgstr ""
"Spotkania to małe wydarzenia organizowane ręcznie. Publiczne widnieją na "
"stronie wydarzeń dla wszystkich."

#: gates/web/django/forms.py
msgid "Category name is too long (max 255 characters)."
msgstr "Nazwa kategorii jest za długa (max 255 znaków)."

#: gates/web/django/forms.py
msgid "Category name is required."
msgstr "Nazwa kategorii jest wymagana."

#: gates/web/django/forms.py
msgid "When a seat becomes available"
msgstr "Gdy zwolni się miejsce"

#: gates/web/django/forms.py
msgid "Confirm the next person automatically"
msgstr "Automatycznie potwierdź udział następnej osoby"

#: gates/web/django/forms.py
msgid "Hold the seat until the next person confirms"
msgstr "Zarezerwuj miejsce do czasu potwierdzenia przez następną osobę"

#: gates/web/django/forms.py
msgid "Time to confirm the seat"
msgstr "Czas na potwierdzenie miejsca"

#: gates/web/django/forms.py
msgid "Minutes before an unconfirmed seat goes to the next person."
msgstr ""
"Liczba minut, po których niepotwierdzone miejsce przechodzi na następną "
"osobę."

#: gates/web/django/forms.py
msgid "Minimum participants limit cannot exceed maximum."
msgstr "Minimalna liczba uczestników nie może przekraczać maksymalnej."

#: gates/web/django/forms.py
msgid "Set how long a held seat waits for confirmation."
msgstr "Ustaw, jak długo zajęte miejsce czeka na potwierdzenie."

