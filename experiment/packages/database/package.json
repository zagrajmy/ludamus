{
  "name": "@zagrajmy/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "src"],
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./*": { "types": "./src/*.ts", "import": "./dist/*.js", "default": "./dist/*.js" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": { "@effect/sql-sqlite-node": "4.0.7", "@zagrajmy/core": "workspace:*", "effect": "4.0.7" },
  "devDependencies": {
    "@effect/vitest": "4.0.7",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
