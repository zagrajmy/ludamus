# Declared environment for the experiment. No values here; the mise tasks
# in the repo root pass the e2e values.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# SQLite file the Django seed produced (tests/e2e). Postgres is not wired in the slice.
# @type=string
DATABASE_PATH=

# Must equal Django's SECRET_KEY, which signs the sessionid payloads this app verifies.
# @type=string
# @sensitive=true
SECRET_KEY=

# @type=number
PORT=

# Origin the host resolves request targets against; the sphere comes from the Host header.
# @type=url
PUBLIC_ORIGIN=
