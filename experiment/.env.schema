# Declared environment for the experiment. No values here; the mise tasks
# in the repo root pass the e2e values.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# SQLite file the Django seed produced (tests/e2e). Postgres is not wired in the slice.
# @type=string
DATABASE_PATH=

# Must equal Django's SECRET_KEY, which signs the sessionid payloads this app verifies.
# @type=string
# @sensitive=true
SECRET_KEY=

# Port the Node host listens on (default 8000).
# @type=number
PORT=

# Scheme and default host of the public site (default http://localhost:8000). Pages and /rpc take the sphere from the Host header; /mcp serves the sphere of this origin.
# @type=url
PUBLIC_ORIGIN=

# Directory Django's MEDIA_ROOT points at (uploaded covers and logos), served read-only at /media/ with no directory listing; leave unset to serve no media.
# @type=string
MEDIA_ROOT=

# Bearer token that opens /mcp; leave unset to keep the MCP endpoint off (it answers 404).
# @type=string
# @sensitive=true
MCP_TOKEN=

# Directory Django's file mail backend would write to; when set, notification mail is written there as one file per message. Without it, EMAIL_URL=filemail:///<path> (relative to the database's directory) is read the same way; otherwise mail is only logged.
# @type=string
EMAIL_FILE_PATH=
